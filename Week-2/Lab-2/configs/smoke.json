{
  "experiment_name": "lab2-local-smoke",
  "seed": 2026,
  "backend": "mock",
  "output_dir": "results/smoke",
  "task": {
    "name": "bundled-nli",
    "labels": ["entailment", "neutral", "contradiction"]
  },
  "data": {
    "train": "data/task/train.jsonl",
    "dev": "data/task/dev.jsonl",
    "test": "data/task/test.jsonl",
    "knowledge": "data/general_knowledge.jsonl",
    "knowledge_limit": 8
  },
  "models": {
    "base": {"id": "mock-base", "revision": "bundled-v1"},
    "instruct": {"id": "mock-instruct", "revision": "bundled-v1"},
    "sft": {"id": "mock-instruct", "revision": "bundled-v1"}
  },
  "prompting": {
    "few_shot_count": 3
  },
  "decoding": {
    "strategy": "greedy",
    "temperature": 0,
    "do_sample": false,
    "num_beams": 1,
    "max_new_tokens": 16
  },
  "training": {
    "adapter_dir": "results/smoke/adapter",
    "lora_r": 4,
    "lora_alpha": 8,
    "lora_dropout": 0.0,
    "target_modules": "all-linear",
    "learning_rate": 0.0002,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.03,
    "num_train_epochs": 1.5,
    "per_device_train_batch_size": 2,
    "per_device_eval_batch_size": 2,
    "gradient_accumulation_steps": 1,
    "max_length": 256,
    "logging_steps": 1,
    "eval_steps": 2
  },
  "plot": {
    "format": "svg"
  }
}
